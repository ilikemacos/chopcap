# Convert temperatures and print a small table.
use math

fun to_fahrenheit(c):
    return c * 9 / 5 + 32

fun to_celsius(f):
    return (f - 32) * 5 / 9

say "A few conversions:"
for c in -10 to 40:
    if c % 10 == 0:
        say text(c) + "C is " + text(math.round(to_fahrenheit(c), 1)) + "F"

say ""
say "98.6F is", math.round(to_celsius(98.6), 1), "degrees Celsius."
